source "https://rubygems.org"

# The `github-pages` gem pins the exact versions GitHub Pages uses to build the
# site — including jekyll-feed, jekyll-seo-tag and jekyll-sitemap — so a local
# preview matches what actually gets published. Do not add those three
# separately; that fights the pin.
gem "github-pages", group: :jekyll_plugins

# Jekyll's dev server on Ruby 3.x.
gem "webrick", "~> 1.8"
